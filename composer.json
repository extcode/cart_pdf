{
    "name": "extcode/cart-pdf",
    "type": "typo3-cms-extension",
    "description": "Shopping Cart(s) for TYPO3 - PDF Renderer for Invoices and Delivery Notes",
    "homepage": "https://cart.extco.de",
    "license": [
        "GPL-2.0+"
    ],
    "keywords": [
        "TYPO3 CMS",
        "Shopping Cart",
        "PDF",
        "cart"
    ],
    "authors": [
        {
            "name": "Daniel Gohlke",
            "email": "ext@extco.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/extcode/cart_pdf/issues"
    },
    "autoload": {
        "psr-4": {
            "Extcode\\CartPdf\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Extcode\\CartPdf\\Tests\\": "Tests"
        }
    },
    "config": {
	"bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor",	
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cart_pdf",
            "web-dir": ".Build/public"
       }
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-fileinfo": "*",
        "typo3/cms-core": "^13.4",
        "extcode/cart": "^11.5",
        "tecnickcom/tcpdf": "^6.7"
    },
    "require-dev": {
        "codappix/typo3-php-datasets": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.59",
        "helmich/typo3-typoscript-lint": "^3.2",
        "phpstan/phpstan": "^2.1",
        "smalot/pdfparser": "^2.12",
        "typo3/testing-framework": "^9.3"
    },
    "scripts": {
        "project:cgl": "Build/Scripts/cgl.sh",
        "project:cgl:fix": "Build/Scripts/cgl.sh --fix",
        "project:lint:php": "Build/Scripts/lint-php.sh",
        "project:phpstan": "Build/Scripts/phpstan.sh",
        "project:test:unit": "Build/Scripts/phpunit.sh unit",
        "project:test:functional": "Build/Scripts/phpunit.sh functional"
    }
}
